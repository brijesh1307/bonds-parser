# Bonds Deal Slip Parser - configuration
# Copy to .env and adjust. Every value below is the default (docs/00_design_baseline.md section 9).

# Files (no database: deal slips are never stored - docs/adr/0009)
BONDS_DATA_DIR=./data
BONDS_TEMPLATES_DIR=./templates
BONDS_CLIENTS_FILE=./data/clients.json
BONDS_AUDIT_FILE=./data/audit/audit.jsonl

# Upload limits
BONDS_MAX_UPLOAD_MB=10
BONDS_MAX_PAGES=20

# Parsing thresholds
BONDS_CONFIDENCE_THRESHOLD=0.90
BONDS_TEMPLATE_MATCH_THRESHOLD=0.80

# API
BONDS_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
BONDS_DOCS_ENABLED=true

# Auth brute-force limiter
BONDS_AUTH_MAX_FAILURES=10
BONDS_AUTH_WINDOW_SECONDS=300
BONDS_AUTH_BLOCK_SECONDS=900

# Operations
BONDS_LOG_LEVEL=INFO
BONDS_AUDIT_RETENTION_YEARS=8
